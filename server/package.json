{
  "name": "stxsim-server",
  "version": "1.0.0",
  "description": "Stock Market Simulator - Backend",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "seed": "node prisma/seed.js",
    "migrate": "npx prisma migrate dev --name init",
    "build": "npx prisma generate && npx prisma db push --accept-data-loss && npm install --include=dev --prefix ../client && npm run build --prefix ../client && npx shx rm -rf public && npx shx cp -r ../client/dist public"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^5.1.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "csv-writer": "^1.6.0",
    "dotenv": "^17.3.1",
    "express": "^4.21.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "prisma": "^5.22.0",
    "shx": "^0.3.4"
  }
}